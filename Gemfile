source "https://rubygems.org"

# Local preview only: GitHub Pages builds the site with its own Jekyll. This site uses no
# remote theme and only jekyll-feed, so Jekyll 4.x renders it the same way. (The
# `github-pages` gem pins Liquid 4.0.3, which breaks on Ruby 3.2+.)
gem "jekyll", "~> 4.3"
gem "jekyll-feed", "~> 0.17"
gem "webrick"

# Ruby 3.4+/4.0 no longer bundle these as default gems.
gem "csv"
gem "base64"
gem "bigdecimal"
gem "logger"
gem "ostruct"
